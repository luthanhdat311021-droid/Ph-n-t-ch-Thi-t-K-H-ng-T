amily=Times New Roman;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="337.5" y="171.0" as="sourcePoint" /><mxPoint x="236.2" y="171.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c31" value="4. Hiển thị hóa đơn,&lt;br&gt;tổng tiền" style="html=1;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;fontSize=11;fontFamily=Times New Roman;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="226.3" y="214.5" as="sourcePoint" /><mxPoint x="125.0" y="214.5" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c32" value="5. Chọn hình thức thanh&lt;br&gt;toán" style="html=1;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;fontSize=11;fontFamily=Times New Roman;endArrow=block;endFill=1;startArrow=oval;startFill=1;startSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125.0" y="292.0" as="sourcePoint" /><mxPoint x="226.3" y="292.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c33" value="6.1. Quẹt / chạm thẻ" style="html=1;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;fontSize=11;fontFamily=Times New Roman;endArrow=block;endFill=1;startArrow=oval;startFill=1;startSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125.0" y="356.0" as="sourcePoint" /><mxPoint x="226.3" y="356.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c34" value="7.1. Gửi yêu cầu xác thực thẻ" style="html=1;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;fontSize=11;fontFamily=Times New Roman;endArrow=block;endFill=1;startArrow=oval;startFill=1;startSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="236.2" y="386.0" as="sourcePoint" /><mxPoint x="448.8" y="386.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c35" value="8.1. Trả kết quả giao dịch" style="html=1;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;fontSize=11;fontFamily=Times New Roman;endArrow=open;endFill=0;da