<mxfile host="app.diagrams.net"><diagram id="d1" name="Hoạt động - Tiếp nhận đơn hàng và cập nhật trạng thái làm bánh"><mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="660" pageHeight="837" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="Nhân viên bếp" style="swimlane;html=1;startSize=36;fillColor=#D6E4F5;swimlaneFillColor=#FFFFFF;fontStyle=1;fontSize=13;strokeWidth=1.3;collapsible=0;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="2.0" y="2.0" width="308.0" height="793.0" as="geometry" /></mxCell><mxCell id="c3" value="Hệ thống" style="swimlane;html=1;startSize=36;fillColor=#D6E4F5;swimlaneFillColor=#FFFFFF;fontStyle=1;fontSize=13;strokeWidth=1.3;collapsible=0;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="310.0" y="2.0" width="308.0" height="793.0" as="geometry" /></mxCell><mxCell id="c4" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="456.0" y="61.0" width="18.0" height="18.0" as="geometry" /></mxCell><mxCell id="c5" value="Phát âm báo, hiển thị đơn mới theo thứ tự thời gian" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#EAF1FB;fontSize=12;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="367.5" y="119.0" width="195.0" height="42.0" as="geometry" /></mxCell><mxCell id="c6" value="Xem chi tiết đơn, chọn “Nhận đơn”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#EAF1FB;fontSize=12;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="57.5" y="189.0" width="195.0" height="42.0" as="geometry" /></mxCell><mxCell id="c7" value="Chuyển trạng thái “Chuẩn bị nguyên liệu”, đồng bộ màn hình bàn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#EAF1FB;fontSize=12;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="367.5" y="251.8" width="195.0" height="56.